# Modulo Formspree dedicato a Luca Germano (solo ID, non l'URL).
# Lasciare vuoto finché Luca non ha visionato il sito.
# L'invio resta disattivato da site.contactForm.enabled in src/lib/site.ts.
FORMSPREE_FORM_ID=

# Recensioni Google (Places API "New"): fino a 5 recensioni pubbliche della scheda.
# Senza queste variabili il sito mostra le testimonianze in src/data/recensioni.ts.
GOOGLE_PLACES_API_KEY=
# Place ID della scheda di Luca (https://developers.google.com/maps/documentation/places/web-service/place-id)
GOOGLE_PLACE_ID=
# Facoltativo: link alla scheda Google mostrato con le testimonianze locali
GOOGLE_REVIEWS_URL=
